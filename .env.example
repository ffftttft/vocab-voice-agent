# 复制为 .env 后填写。config.yaml 里的 ${VAR:default} 会读取这里。

# ===== 文本模型（走中转站，成本优先）=====
TEXT_LLM_BASE_URL=https://your-relay.example.com/v1
TEXT_LLM_API_KEY=sk-xxxxxxxx
TEXT_LLM_MODEL=deepseek-v4.1-flash

# ===== 实时语音（走官方阿里百炼）=====
VOICE_PROVIDER=qwen_omni
VOICE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
VOICE_API_KEY=sk-xxxxxxxx
VOICE_MODEL=qwen-omni-turbo-realtime
VOICE_ID=Chelsie

# ===== TTS（默认免费 Edge-TTS，无需 key）=====
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-AndrewMultilingualNeural

# ===== 运行环境 =====
APP_ENV=dev
